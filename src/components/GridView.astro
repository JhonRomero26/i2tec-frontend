---
import type { HTMLAttributes } from "astro/types"
import NoFoundContent from "./NoFoundContent.astro"

type Props = {
	minWidth?: "min-content" | "max-content" | string
	gap?: string
	class?: string
} & HTMLAttributes<"div">

const { minWidth = "300px", gap = "1rem", class: className } = Astro.props
---

<div
	class:list={["relative grid", className]}
	style={{
		gap,
		gridTemplateColumns: `repeat(auto-fill, minmax(${minWidth}, 1fr))`,
	}}
>
	<slot>
		<NoFoundContent />
		<NoFoundContent />
		<NoFoundContent />
		<NoFoundContent />
	</slot>
</div>
