---
import { Image } from "astro:assets"
import snarkdown from "snarkdown"

interface Props {
	name: string
	image?: string
	summary: string
}

const { name, image, summary } = Astro.props
---

<div
	class="isolate mx-auto grid w-full max-w-screen-xl gap-8 rounded-lg bg-white/10 p-12 shadow-lg backdrop-blur dark:bg-gray-950/10 lg:grid-cols-[0.5fr_1fr]"
>
	<div class="flex justify-center lg:flex-col lg:justify-normal">
		<figure
			class="relative ml-12 mt-12 block aspect-[3/4] h-72 before:absolute before:bottom-12 before:right-12 before:z-[-1] before:h-full before:w-full before:rounded-lg before:border-8 before:border-solid before:border-primary before:content-[''] sm:h-96 lg:h-min"
		>
			{
				image ? (
					<Image
						inferSize
						data-ref="TeacherDetail-image"
						loading="lazy"
						class="h-full w-full rounded-lg object-cover object-center"
						src={image}
						alt={name}
					/>
				) : (
					<img
						data-ref="TeacherDetail-image"
						loading="lazy"
						class="h-full w-full rounded-lg object-cover object-center"
						src="/user-placeholder.webp"
						alt={name}
					/>
				)
			}
		</figure>
	</div>
	<div class="flex flex-col gap-4">
		<div data-ref="TeacherDetail-name" class="text-3xl font-bold text-primary lg:text-4xl">
			{name}
		</div>
		<div
			data-ref="TeacherDetail-summary"
			class="prose-headings:font-heading prose-headings:leading-tighter prose-md prose leading-relaxed dark:prose-invert lg:prose-xl prose-headings:mt-8 prose-headings:scroll-mt-8 prose-headings:font-bold prose-headings:tracking-tighter prose-a:text-accent prose-ul:my-0 prose-li:my-0 prose-img:rounded-md prose-img:shadow-lg"
			set:html={snarkdown(summary)}
		/>
	</div>
</div>
