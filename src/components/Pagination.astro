---
import ChevronLeftIcon from "@/icons/ChevronLeftIcon.astro"
import ChevronRightIcon from "@/icons/ChevronRightIcon.astro"

interface Props {
	length: number
	currentPage: number
	urlPag?: string
	prevUrl?: string
	nextUrl?: string
	class?: string
}

const { length, currentPage, urlPag, prevUrl, nextUrl, class: className } = Astro.props

const disabledNavClass = "cursor-not-allowed bg-ui-01 text-gray-200"
const activeNavClass = "bg-white hover:bg-ui-01 hover:text-gray-700"
const defaultClass = "flex items-center justify-center px-4 h-10 leading-tight"

const paginationList: number[] = Array.from({ length }, (_, i) => i + 1)
---

<nav class:list={className} aria-label="Pagination">
	<ul class="inline-flex h-10 flex-wrap -space-x-px text-base">
		<li>
			{
				prevUrl ? (
					<a
						href={`${urlPag}${prevUrl}`}
						class:list={[
							defaultClass,
							"rounded-l-lg",
							{
								[activeNavClass]: Boolean(prevUrl),
								[disabledNavClass]: !prevUrl,
							},
						]}
					>
						<ChevronLeftIcon />
					</a>
				) : (
					<span
						class:list={[
							defaultClass,
							"rounded-l-lg",
							{
								[activeNavClass]: Boolean(prevUrl),
								[disabledNavClass]: !prevUrl,
							},
						]}
					>
						<ChevronLeftIcon />
					</span>
				)
			}
		</li>
		{
			paginationList.map((pag) => (
				<li>
					<a
						href={`${urlPag}${pag}`}
						class:list={[
							defaultClass,
							{
								"bg-accent cursor-not-allowed text-white": currentPage === pag,
								[activeNavClass]: currentPage !== pag,
							},
						]}
					>
						{pag}
					</a>
				</li>
			))
		}
		<li>
			{
				nextUrl ? (
					<a
						href={`${urlPag}${nextUrl}`}
						class:list={[
							defaultClass,
							"rounded-r-lg",
							{
								[activeNavClass]: Boolean(nextUrl),
								[disabledNavClass]: !nextUrl,
							},
						]}
					>
						<ChevronRightIcon />
					</a>
				) : (
					<span
						class:list={[
							defaultClass,
							"rounded-r-lg",
							{
								[activeNavClass]: Boolean(nextUrl),
								[disabledNavClass]: !nextUrl,
							},
						]}
					>
						<ChevronRightIcon />
					</span>
				)
			}
		</li>
	</ul>
</nav>
