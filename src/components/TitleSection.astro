---
interface Props {
	title: string
	description: string
	class?: string
	as: "h1" | "h2" | "h3" | "h4" | "h5" | "h6"
	titleSize: "sm" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl" | "7xl" | "8xl" | "9xl"
}

const { title, description, as: Title = "h2", titleSize = "4xl", class: className } = Astro.props
---

<div class:list={["mx-auto flex max-w-lg flex-col text-center", className]}>
	<Title
		class:list={[
			"mb-4 text-4xl font-bold text-primary",
			{
				[`text-${titleSize}`]: titleSize,
			},
		]}>{title}</Title
	>
	<p class="text-balance">
		{description}
	</p>
</div>
