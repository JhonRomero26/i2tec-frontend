---
import type { Category } from "@/models";
import { Icon } from "astro-icon/components";

type Props = {
  title: string;
  categories?: Category[];
};

const { title, categories } = Astro.props;
---

<div
  class="flex flex-col justify-between max-w-3xl mx-auto sm:flex-row sm:px-6 mt-8 px-6"
>
  <ul class="mr-5 rtl:ml-5 rtl:mr-0">
    {
      categories?.map(({ name }) => (
        <li class="mb-2 font-medium bg-gray-100 dark:bg-slate-700 inline-block lowercase mr-2 px-2 py-0.5 rtl:ml-2 rtl:mr-0">
          <a
            href={`/tag/${name}`}
            class="text-muted hover:text-primary dark:hover:text-gray-200 dark:text-slate-300"
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="align-middle mt-5 sm:mt-1 text-gray-600">
    <span class="font-bold align-super text-slate-700">Share:</span>
    <button
      id="x-share"
      class="rtl:ml-0 ml-2 rtl:mr-2"
      data-social-share="X"
      title="X Share"
      data-text={title}
    >
      <Icon
        name="tabler:brand-x"
        class="w-6 h-6 hover:text-slate-500 text-gray-700"
      />
    </button>
    <button
      id="fb-share"
      data-href={Astro.url}
      data-lazy="true"
      class="rtl:ml-0 ml-2 rtl:mr-2"
      data-social-share="facebook"
      data-href={Astro.url}
      title="Facebook Share"
      data-text={title}
    >
      <Icon
        name="tabler:brand-facebook"
        class="w-6 h-6 hover:text-slate-500 text-gray-700"
      />
    </button>
    <!-- <button
      id="linkedin-share"
      class="rtl:ml-0 ml-2 rtl:mr-2"
      data-social-share="linkedin"
      data-url={Astro.url}
      title="Linkedin Share"
      data-text={title}
    >
      <Icon
        name="tabler:brand-linkedin"
        class="w-6 h-6 hover:text-slate-500 text-gray-700"
      />
    </button> -->
  </div>

  <script>
    const pageURL = `i2tec.ec${window.location.pathname}`;
    const xShare = document.getElementById("x-share");
    const fbShare = document.getElementById("fb-share");
    const linkedinShare = document.getElementById("linkedin-share");

    const $title = document.getElementById("post-title");
    const $excerpt = document.getElementById("post-excerpt");

    const title = $title?.textContent;
    const excerpt = $excerpt?.textContent;
    const text = `¡No te pierdas de los nuevos projectos del I2TEC!
${title}

${excerpt}

→ ${pageURL}`;

    const handleShare = async () => {
      const intent = "https://twitter.com/intent/tweet";
      window.open(`${intent}?text=${encodeURIComponent(text)}`);
    };

    const handleFbShare = async () => {
      const intent = "https://www.facebook.com/sharer/sharer.php";
      window.open(`${intent}?u=${encodeURIComponent(pageURL)}`);
    };

    const handleLkShare = async () => {
      const intent = "https://api.linkedin.com/v2/ugcPosts";
      window.open(`${intent}?text=${encodeURIComponent(text)}`);
    };

    xShare?.addEventListener("click", handleShare);
    fbShare?.addEventListener("click", handleFbShare);
    linkedinShare?.addEventListener("click", handleLkShare);
  </script>
</div>
