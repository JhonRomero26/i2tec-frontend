---
import SearchIcon from "@/icons/SearchIcon.astro"

interface Props {
	id: string
	value?: string
	placeholder: string
	class?: string
	name: string
}

const { id, name, placeholder, value, class: className } = Astro.props
---

<div class:list={["relative", className]}>
	<button
		id={id}
		aria-label="Buscar"
		class="absolute left-0 top-1/2 flex -translate-y-1/2 items-center justify-center p-2 text-2xl text-muted"
		type="submit"
	>
		<SearchIcon />
	</button>
	<input class="input pl-10" value={value} name={name} placeholder={placeholder} />
</div>
