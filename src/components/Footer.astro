---
import { APP_ROUTES } from "@/consts/routing"
---

<footer class="bg-ui-01 m-4 rounded-lg shadow">
	<div class="container w-full py-8">
		<div class="flex flex-col items-center sm:flex-row sm:justify-between">
			<a
				href="https://i2tec.ec/"
				class="mb-8 flex items-center space-x-3 sm:mb-0 rtl:space-x-reverse"
			>
				<img
					loading="lazy"
					class="max-w-32 dark:hidden"
					src="/i2tec-logo.webp"
					alt="Logo del centro de investigación, innovación y tecnología"
				/>
				<img
					loading="lazy"
					class="hidden max-w-32 dark:block"
					src="/i2tec-dark.webp"
					alt="Logo del centro de investigación, innovación y tecnología"
				/>
			</a>
			<ul class="mb-6 flex flex-wrap items-center text-sm font-medium sm:mb-0">
				{
					APP_ROUTES.map(({ path, label }) => (
						<li>
							<a href={path} class="me-4 hover:underline md:me-6">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<hr class="my-6 border-gray-200 sm:mx-auto lg:my-8 dark:border-gray-700" />
		<span class="block text-center text-sm"
			>© {new Date().getFullYear()} Desarrollado por <a
				href="https://jhonromero26.vercel.app/"
				class="hover:underline">@JhonRomero26</a
			></span
		>
	</div>
</footer>
