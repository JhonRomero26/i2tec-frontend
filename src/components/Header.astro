---
import BurgerButton from "@/components/BurgerButton.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { APP_ROUTES } from "@/consts/routing"

const { pathname } = Astro.url
---

<header>
	<div id="header" class="fixed left-0 top-0 z-50 w-full px-4 py-6 text-primary">
		<div class="container flex h-full items-center justify-between">
			<a class="relative mr-4 flex h-full w-28 flex-1" href="/">
				<img
					loading="lazy"
					class="max-w-32 dark:hidden"
					src="/i2tec-logo.webp"
					alt="Logo del centro de investigación, innovación y tecnología"
				/>
				<img
					loading="lazy"
					class="hidden max-w-32 dark:block"
					src="/i2tec-dark.webp"
					alt="Logo del centro de investigación, innovación y tecnología"
				/>
			</a>
			<nav
				id="header-navigator"
				class="absolute right-8 top-full z-20 w-full max-w-48 flex-1 justify-center gap-4 rounded max-md:invisible max-md:flex-col max-md:bg-ui01 max-md:py-2 max-md:opacity-0 max-md:shadow md:static md:flex md:flex-row md:items-center md:p-0"
			>
				<ul class="flex flex-col text-sm md:flex-row">
					{
						APP_ROUTES.map(({ label, path }) => (
							<li>
								<a
									class:list={[
										"block border-transparent px-4 py-2 font-medium transition-colors hover:text-accent max-md:hover:bg-brand-500/25 md:hover:border-accent",
										pathname === path && "text-accent",
									]}
									href={path}
								>
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<div class="flex flex-1 justify-end">
				<ThemeToggle />
				<BurgerButton />
			</div>
		</div>
	</div>
</header>

<script>
	const onLoad = () => {
		const $burgerBtn = document.querySelector("#burger-button") as HTMLButtonElement
		const $navigator = document.querySelector("#header-navigator") as HTMLElement

		const $cover = document.createElement("div")
		$cover.classList.add("overlay")

		const handleClickButton = () => {
			$navigator.classList.toggle("max-md:opacity-0")
			$navigator.classList.toggle("max-md:invisible")
			$navigator.classList.toggle("max-md:h-max")
		}

		$burgerBtn.addEventListener("click", handleClickButton)
	}
	onLoad()

	document.addEventListener("astro:after-swap", () => {
		onLoad()
	})
</script>
