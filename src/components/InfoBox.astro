---
interface Props {
	title: string
	decoration?: "right" | "left"
	backgroundColor?: string
	boxColor?: string
	class?: string
}

const {
	title,
	decoration = "left",
	backgroundColor = "bg-accent",
	boxColor = "bg-body",
	class: className,
} = Astro.props
---

<div class:list={["relative isolate mx-[2.5%] my-[5%] h-min", className]}>
	<div
		class:list={[
			"absolute z-[-1] block h-full w-full border-2 border-solid border-accent",
			{
				"right-[2.5%] top-[5%]": decoration === "left",
				"bottom-[5%] left-[2.5%]": decoration === "right",
			},
			backgroundColor,
		]}
	>
	</div>
	<div
		class:list={`${boxColor} boder-2 border-2 border-solid border-accent p-12 saturate-200 backdrop-blur-sm`}
	>
		<h3 class="mb-4 text-2xl font-bold text-inherit">{title}</h3>
		<div class="flex flex-col gap-4"><slot /></div>
	</div>
</div>
