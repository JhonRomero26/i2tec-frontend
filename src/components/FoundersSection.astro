---
import Avatar from "@/components/Avatar.astro"
import { BACKEND_URL } from "@/consts/app"
import type { Person } from "@/models/Person"
import { getPeople } from "@/services/people"
import { getImageFormat } from "@/utils/image"

const response = {
	data: [] as Person[],
	error: false,
	message: "",
}
await getPeople({
	query: ["fields[0]=first_name", "fields[1]=last_name", "filters[founder][$equal]=true"],
})
	.then(({ data }) => {
		response.data = data!
	})
	.catch((_) => {
		response.error = true
	})
---

<section class="py-24">
	<div class="container">
		<h2 class="mb-16 text-center text-4xl font-bold">Nuestros fundadores</h2>
		<div class="flex flex-col gap-8 xs:flex-row md:gap-12">
			{
				response.data!.length > 0 &&
					response.data?.map(({ first_name, last_name, avatar }) => (
						<div class="flex w-full flex-col items-center gap-3">
							<Avatar
								class="h-44 w-44"
								image={
									avatar
										? `${BACKEND_URL}${getImageFormat(avatar, "small")}`
										: "/user-placeholder.webp"
								}
								alt={`${first_name} ${last_name}`}
							/>
							<span class="text-center text-xl">{`${first_name} ${last_name}`}</span>
						</div>
					))
			}
		</div>
		<div class="mt-16 flex justify-center">
			<a class="btn btn-secondary" href="/about-us/teachers">Todos nuestros docentes</a>
		</div>
	</div>
</section>
