---
import { ViewTransitions } from "astro:transitions"

import ApplyColorMode from "@/components/ApplyColorMode.astro"
import Footer from "@/components/Footer.astro"
import Header from "@/components/Header.astro"
import SEO from "@/components/SEO.astro"
import "@/global.css"
import type { Preload } from "@/types/Preload"

interface Props {
	title: string
	description: string
	canonical?: string
	image?: string
	preload?: Array<Preload>
}

const { title, description, canonical, image, preload } = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<SEO
			title={title}
			description={description}
			canonical={canonical}
			preload={preload}
			image={image}
		/>
		<ViewTransitions fallback="swap" />
		<ApplyColorMode />
	</head>
	<body class="min-h-lvh">
		<Header transition:persist />
		<main class="min-h-lvh">
			<slot />
		</main>
		<Footer />
	</body>
</html>
