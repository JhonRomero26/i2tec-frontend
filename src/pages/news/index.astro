---
import GridView from "@/components/GridView.astro"
import HeroRadial from "@/components/HeroRadial.astro"
import HorizontalScroller from "@/components/HorizontalScroller.astro"
import ImageSkeleton from "@/components/ImageSkeleton.astro"
import LastestNews from "@/components/LastestNews.astro"
import NewsCard from "@/components/NewsCard.astro"
import NoFoundContent from "@/components/NoFoundContent.astro"
import Pagination from "@/components/Pagination.astro"
import SearchBox from "@/components/SearchBox.astro"
import TitleSection from "@/components/TitleSection.astro"
import { BACKEND_URL } from "@/consts/app"
import Layout from "@/layouts/Layout.astro"
import type { News } from "@/models/News"
import { getTidings } from "@/services/tidings"
import { getImageFormat } from "@/utils/image"

const searchParam: string = Astro.url.searchParams.get("q") || ""
const pagParam = Astro.url.searchParams.get("pag") || ""

const pagination = {
	count: 0,
	currentPage: 1,
	pages: {
		next: "",
		prev: "",
	},
}
const response = {
	data: {
		lastestNews: [] as News[],
		allTidings: [] as News[],
	},
	error: false,
	message: "Hubo un error al obtener las noticias.",
}

await getTidings({
	query: [
		"sort[0]=publishedAt:desc",
		"pagination[pageSize]=36",
		pagParam && `pagination[page]=${pagParam}`,
		searchParam && `filters[title][$containsi]=${searchParam}`,
	],
})
	.then(({ data, meta }) => {
		response.data.lastestNews = data!.slice(0, 3)
		response.data.allTidings = data!.slice(3)
		pagination.count = meta.pagination.pageCount
		pagination.currentPage = pagParam ? Number(pagParam) : 1
		pagination.pages.next =
			pagination.count > pagination.currentPage ? `${pagination.currentPage + 1}` : ""
		pagination.pages.prev =
			pagination.count < pagination.currentPage ? `${pagination.currentPage - 1}` : ""
	})
	.catch((_) => {
		response.error = true
	})

const existsTidings = response.data.allTidings && response.data.allTidings.length > 0
const [, firstPath] = Astro.url.pathname.split("/")
---

<Layout
	title="Noticias | I2TEC"
	description="Las noticias más relevantes en el mundo de la innovación en las que el I2TEC trabaja con docentes y investigadores."
>
	<HeroRadial class="pb-12 pt-36">
		<div class="container">
			<TitleSection
				as="h1"
				class="mb-24 text-center"
				title="Somos influyentes en el mundo de la innovación"
				description="Encuentra noticias acerca de nosotros en todo el mundo. Encuentralas en nuestra sección de noticias."
			/>
			<form class="mx-auto flex max-w-2xl items-center">
				<SearchBox
					class="w-full"
					id="search-projects"
					name="q"
					value={searchParam}
					placeholder="KIT 2.0 UNL"
				/>
			</form>
		</div>
	</HeroRadial>
	{
		!searchParam && response.data.lastestNews && (
			<section class="my-24">
				<div class="container">
					<h2 class="mb-12 text-2xl font-semibold">Últimas noticias</h2>
				</div>
				<HorizontalScroller>
					{response.error ? (
						<NoFoundContent message={response.message} />
					) : (
						response.data.lastestNews.map((news) => {
							const imageSrc = getImageFormat(news.image, "medium")

							if (imageSrc === undefined) return <ImageSkeleton />

							return (
								<LastestNews
									class="slide min-w-[500px]"
									title={news.title}
									summary={news.description}
									image={`${BACKEND_URL}${imageSrc}`}
									publishedAt={news.publishedAt}
									facebookUrl={news.facebook_url}
									instagramUrl={news.instagram_url}
								/>
							)
						})
					)}
				</HorizontalScroller>
			</section>
		)
	}

	<section class="my-24">
		<div class="container">
			<h6 class="mb-12 text-2xl font-semibold">
				{!searchParam ? "Todas las noticias" : `Resultados de la busqueda: ${searchParam}`}
			</h6>
			<GridView class="relative min-h-96" minWidth="350px">
				{
					existsTidings ? (
						response.data.allTidings.map((news) => (
							<NewsCard
								instagramUrl={news.instagram_url}
								facebookUrl={news.facebook_url}
								description={news.description}
								title={news.title}
								image={`${BACKEND_URL}${getImageFormat(news.image, "small")}`}
								publishedAt={news.publishedAt}
							/>
						))
					) : (
						<NoFoundContent absolute />
					)
				}
			</GridView>
			{
				existsTidings && (
					<Pagination
						class="mt-24 flex justify-center"
						urlPag={`/${firstPath}?pag=`}
						prevUrl={`${pagination.pages.prev}`}
						nextUrl={`${pagination.pages.next}`}
						currentPage={pagination.currentPage}
						length={pagination.count}
					/>
				)
			}
		</div>
	</section>
</Layout>
