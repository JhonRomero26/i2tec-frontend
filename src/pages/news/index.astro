---
import GridView from "@/components/GridView.astro"
import HeroRadial from "@/components/HeroRadial.astro"
import HorizontalScroller from "@/components/HorizontalScroller.astro"
import ImageSkeleton from "@/components/ImageSkeleton.astro"
import LastestNews from "@/components/LastestNews.astro"
import NewsCard from "@/components/NewsCard.astro"
import NoFoundContent from "@/components/NoFoundContent.astro"
import Pagination from "@/components/Pagination.astro"
import SearchBox from "@/components/SearchBox.astro"
import TitleSection from "@/components/TitleSection.astro"
import { BACKEND_URL } from "@/consts/app"
import Layout from "@/layouts/Layout.astro"
import type { News } from "@/models/News"
import { getTidings } from "@/services/tidings"
import { getImageFormat } from "@/utils/image"

const searchParam: string = Astro.url.searchParams.get("q") || ""
const pagParam = Astro.url.searchParams.get("pag") || ""

const pagination = {
	count: 0,
	currentPage: 1,
	pages: {
		next: "",
		prev: "",
	},
}
const response = {
	data: {
		lastestNews: [] as News[],
		allTidings: [] as News[],
	},
	error: false,
	message: "Hubo un error al obtener las noticias.",
}

await getTidings({
	query: [
		"sort[0]=publishedAt:desc",
		"pagination[pageSize]=36",
		pagParam && `pagination[page]=${pagParam}`,
		searchParam && `filters[title][$containsi]=${searchParam}`,
	],
})
	.then(({ data, meta }) => {
		response.data.lastestNews = data!.slice(0, 3)
		response.data.allTidings = data!.slice(3)
		pagination.count = meta.pagination.pageCount
		pagination.currentPage = pagParam ? Number(pagParam) : 1
		pagination.pages.next =
			pagination.count > pagination.currentPage ? `${pagination.currentPage + 1}` : ""
		pagination.pages.prev =
			pagination.count < pagination.currentPage ? `${pagination.currentPage - 1}` : ""
	})
	.catch((_) => {
		response.error = true
	})

const existsTidings = response.data.allTidings && response.data.allTidings.length > 0
const [, firstPath] = Astro.url.pathname.split("/")
