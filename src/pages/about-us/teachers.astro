---
import NoFoundContent from "@/components/NoFoundContent.astro"
import TeacherCard from "@/components/TeacherCard.astro"
import TeacherDetailSection from "@/components/TeacherDetailSection.astro"
import { BACKEND_URL } from "@/consts/app"
import Layout from "@/layouts/Layout.astro"
import type { Teacher } from "@/models/Teacher"
import { getTeachers } from "@/services/teachers"
import { getImageFormat } from "@/utils/image"

const response = {
	data: [] as Teacher[],
	error: false,
	message: "Hubo un error al obtener las noticias.",
}

await getTeachers()
	.then(({ data }) => {
		response.data = data!
	})
	.catch((_) => {
		response.error = true
	})

if (response.error) return Astro.redirect("/404")

const totalTeachers = response.data.length
const selectedTeacher = totalTeachers > 0 ? response.data[0] : ({} as Teacher)
const { first_name, last_name, avatar } = selectedTeacher?.person
const personData = {
	fullName: `${first_name} ${last_name}`,
	avatar: `${BACKEND_URL}${avatar?.formats.small.url}`,
	biography: selectedTeacher?.biography || "",
}
---

<Layout
	title="Docentes | I2TEC"
	description="Nuestros docentes fundadores y colaboradores en el I2TEC muestran cada día su compromiso para el avance de la tecnología. Conoce a quienes forman parte del I2TEC."
>
	<main>
		<section class="bg-svg-architect bg-ui-01 py-32">
			<div class="container">
				{
					selectedTeacher ? (
						<TeacherDetailSection
							name={personData.fullName}
							image={personData.avatar}
							summary={personData.biography}
						/>
					) : (
						<TeacherDetailSection
							name="No hemos encontrado docentes"
							summary="En breve estaremos presentes con nuevos docentes que participan dentro del I2TEC"
							image="/user-placeholder.webp"
						/>
					)
				}
			</div>
		</section>
		<section class="section pt-40">
			<div class="container">
				<h1 class="text-center text-4xl font-bold">Nuestros docentes</h1>
			</div>
			<div class="container">
				<div class="grid grid-cols-1 gap-4 py-32 lg:grid-cols-2 2xl:grid-cols-3">
					{
						response.error ? (
							<NoFoundContent message={response.message} />
						) : (
							response.data.map(({ id, person: { first_name, last_name, avatar }, biography }) => (
								<div data-id={id} data-ref="CardTeacher">
									<TeacherCard
										class="cursor-pointer"
										firstName={first_name}
										lastName={last_name}
										image={
											avatar
												? `${BACKEND_URL}${getImageFormat(avatar, "small")}`
												: "/user-placeholder.png"
										}
										description={biography}
									/>
								</div>
							))
						)
					}
				</div>
			</div>
		</section>
	</main>
</Layout>

<script is:inline define:vars={{ teachers: response.data }}>
	const onLoad = () => {
		let snarkdown
		import("https://cdnjs.cloudflare.com/ajax/libs/snarkdown/2.0.0/snarkdown.es.min.js").then(
			({ default: _snarkdown }) => (snarkdown = _snarkdown)
		)
		const $cards = document.querySelectorAll("[data-ref='CardTeacher']")
		const $name = document.querySelector("[data-ref='TeacherDetail-name']")
		const $image = document.querySelector("[data-ref='TeacherDetail-image']")
		const $summary = document.querySelector("[data-ref='TeacherDetail-summary']")

		const setTeacherInfo = ({ first_name, last_name, avatar, biography }) => {
			const fullName = `${first_name} ${last_name}`
			$name.innerHTML = fullName
			if (avatar) $image.src = `https://admin.i2tec.ec${avatar.url}`
			$summary.innerHTML = snarkdown(biography)
		}

		$cards.forEach(($card) => {
			$card.addEventListener("click", () => {
				const id = Number($card.getAttribute("data-id"))
				const index = teachers?.findIndex((teacher) => teacher.id === id)
				const {
					person: { first_name, last_name, avatar },
					biography,
				} = teachers?.[index]
				const teacher = {
					avatar,
					first_name,
					biography,
					last_name,
				}
				setTeacherInfo(teacher)
				teachers?.push(teacher)
				window.scroll({ behavior: "smooth", top: 60 })
			})
		})
	}
	onLoad()

	document.addEventListener("astro:after-swap", () => {
		onLoad()
	})
</script>
