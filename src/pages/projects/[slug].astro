---
import ButtonAnchor from "@/components/ButtonAnchor.astro";
import Layout from "@/layouts/Layout.astro";
import ArticlePost from "@/components/ArticlePost.astro";
import { BACKEND_IMAGE } from "@/lib/constants";
import { getImageFormats } from "@/lib/getImageFormats";
import { Icon } from "astro-icon/components";
import { getProject } from "@/services/project";

const { slug = "" } = Astro.params;

const project = await getProject({ slug });
if (!project) Astro.redirect("/404");

const principalImage = getImageFormats(project.image, "large");
console.log(project);
---

<Layout
  title={`${project.title} | I2TEC`}
  description={project.excerpt}
  image={BACKEND_IMAGE.concat(principalImage)}
>
  <section class="mx-auto lg:py-20 py-8 sm:py-16">
    <ArticlePost
      id={`${project.id}`}
      published={project.publishedAt}
      authors={project.authors!}
      content={project.content}
      title={project.title}
      categories={project.categories}
      excerpt={project.excerpt}
      image={BACKEND_IMAGE.concat(principalImage)}
    />
    <div class="mx-auto sm:px-6 max-w-3xl px-6 md:pb-20 md:pt-4 pb-12 pt-8">
      <ButtonAnchor class="btn btn-tertiary md:px-3 px-3" href="/projects">
        <Icon name="tabler:arrow-left" />
        Ver más proyectos
      </ButtonAnchor>
    </div>
  </section>

  <script
    async
    defer
    crossorigin="anonymous"
    src="https://connect.facebook.net/es_LA/sdk.js#xfbml=1&version=v20.0"
    nonce="Yxgs4VZM"></script>
</Layout>
