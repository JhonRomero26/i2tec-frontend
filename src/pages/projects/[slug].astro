---
import ArticlePost from "@/components/ArticlePost.astro"
import { BACKEND_URL } from "@/consts/app"
import ArrowLeftIcon from "@/icons/ArrowLeftIcon.astro"
import Layout from "@/layouts/Layout.astro"
import { getProject } from "@/services/project"
import { getImageFormat } from "@/utils/image"

const { slug = "" } = Astro.params
const project = await getProject({ slug })

if (project) Astro.redirect("/404")

const principalImage = getImageFormat(project.image, "large")
const image = BACKEND_URL.concat(principalImage)
---

<Layout title={`${project.title} | I2TEC`} description={project.excerpt} image={image}>
	<section class="mx-auto py-8 sm:py-16 lg:py-20">
		<ArticlePost
			id={`${project.id}`}
			published={project.publishedAt}
			authors={project.authors!}
			content={project.content}
			title={project.title}
			categories={project.categories}
			excerpt={project.excerpt}
			image={image}
		/>
		<div class="mx-auto max-w-3xl px-6 pb-12 pt-8 sm:px-6 md:pb-20 md:pt-4">
			<a class="btn tertiary px-3 md:px-3" href="/projects">
				<ArrowLeftIcon />
				Ver más proyectos
			</a>
		</div>
	</section>
</Layout>
